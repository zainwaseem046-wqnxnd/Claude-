# --- Required ---
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/cleaningproof
# Directory for private uploads (photos, logos). Must be on persistent storage, never inside dist/.
UPLOAD_DIR=/var/lib/cleaningproof/uploads
# Public base URL of the app (used in emails)
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# --- Stripe (test mode first!) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: existing recurring Price IDs. If unset, prices are created inline at checkout (£19/£29/£49 monthly).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
# Live keys (sk_live_) are refused unless this is set to true, after test mode + webhooks are verified.
STRIPE_ALLOW_LIVE=false

# --- Email (for sending/resending reports) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CleaningProof <reports@example.com>"
